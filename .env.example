# Copy to .env and edit. `.env` is gitignored; this file is not.
#
# Nothing here is required. Every value below has a working default, and the
# Mac profiles need none of them — they read config/mac-polyglot.yaml and run
# every model in-process. This exists for deployments where the services live
# somewhere else, and as the one place credentials go if a hosted provider is
# ever added.
#
# Two readers, and they are not the same:
#   - docker-compose.yml substitutes ${LLM_URL} and ${HF_HOME} directly.
#     Compose reads .env from this directory on its own; nothing else does.
#   - src/voicebot/config.py applies the VOICEBOT_* variables over the loaded
#     profile, so one image can serve every environment. It does not read this
#     file — export them, or let compose put them in the container.

# --- which profile the process runs -----------------------------------------
# One of the names in config/: mac, mac-polyglot, mac-singlish, mac-meralion,
# mock, rhel. Overrides whatever the caller passed, which is what makes a
# single image serve both the demo box and the GPU host.
VOICEBOT_PROFILE=rhel

# --- where the models actually are ------------------------------------------
# Service addresses differ between a laptop, compose (where they are service
# names) and a bare host, so they are not baked into the image. Left unset,
# the profile's own values apply.
VOICEBOT_ASR_URL=http://asr:8801
VOICEBOT_TTS_URL=http://tts:8802
VOICEBOT_LLM_URL=http://host.docker.internal:8000

# Override the model a profile names — for trying a different checkpoint
# without editing config, or pinning one an air-gapped host already holds.
# VOICEBOT_ASR_MODEL=
# VOICEBOT_LLM_MODEL=

# --- everything else ---------------------------------------------------------
# Where the pre-rendered audio cache lives. Point this at a volume that
# survives a rebuild: re-rendering it is GPU-hours, not seconds.
# VOICEBOT_CACHE_DIR=voices/cache

# "standard" or "singlish". The Singlish wording is a rewording of the client's
# approved script and needs Etiqa sign-off before it is used on a real call.
# VOICEBOT_REGISTER=standard

# Read by docker-compose.yml, not by the application.
# HF_HOME=~/.cache/huggingface
# LLM_URL=http://host.docker.internal:8000

# --- credentials -------------------------------------------------------------
# None yet: every model runs locally, so there is nothing to authenticate to.
# When a hosted STT, TTS or LLM provider is added, its key belongs here in
# .env — never in a config file, never in a commit, and never pasted into a
# chat or a ticket. Add the name here with an empty value so the next person
# knows it is expected.
#
# EXAMPLE_PROVIDER_API_KEY=
