.venv*/
__pycache__/
*.pyc
.pytest_cache/
models/
*.log
voices/cache/

# Voices an admin recorded in the console. Someone's voice is not a source
# artefact, and a pull request is not where it belongs.
voices/custom.json
voices/refs/*.wav
# The shipped voices are deployment assets, not somebody's recording.
!voices/refs/male.wav
!voices/refs/female.wav
!voices/refs/bf_isabella.wav
!voices/refs/af_bella.wav
!voices/refs/af_sarah.wav
!voices/refs/am_michael.wav
!voices/refs/am_eric.wav
# The Mandarin speakers every voice clones for a Mandarin call. Kokoro's own
# zf_xiaobei and zm_yunjian reading a Mandarin paragraph — Apache 2.0 output.
!voices/refs/zf_xiaobei.wav
!voices/refs/zm_yunjian.wav

# Service logs. The call transcripts in logs/calls.jsonl are the eval
# corpus and are versioned; the noisy stdout/stderr of the service is not.
logs/*.log

# macOS Finder metadata, which "commit everything" would otherwise sweep in.
.DS_Store

# Provider credentials. Nothing here is committed, and nothing is ever pasted
# into a chat or a ticket — the file is written on the host that needs it.
.env
.env.*
!.env.example

# Generated by `make name-audit`: candidate renderings to listen to. Rebuildable
# in a minute, 600 KB of wav, and stale the moment a voice changes.
voices/audit/
voices/audit-zh/

# Generated by `make tts-bench`: one wav per line per candidate model, and the
# page to listen to them on. Tens of MB, and a re-run is the whole point.
voices/bench/
